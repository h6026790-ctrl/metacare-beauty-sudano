# Copy to .env for local work. Never commit the real .env.
# Backend values are injected automatically in Lovable; these names document
# what the app expects.

# Browser-visible
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only (never expose to the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
